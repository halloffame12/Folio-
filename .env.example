# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/folio_dev?schema=public"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters"
APP_URL="http://localhost:3000"
AUTH_DEV_EXPOSE_LINKS="true"

# Email (console provider is used when no API key is set)
EMAIL_PROVIDER="console"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Folio <no-reply@folio.local>"

# Scholarly APIs
CROSSREF_MAILTO=""
CROSSREF_API_BASE="https://api.crossref.org"
OPENALEX_MAILTO=""
OPENALEX_API_BASE="https://api.openalex.org"

# Rate limiting
RATE_LIMIT_DISABLED="false"
